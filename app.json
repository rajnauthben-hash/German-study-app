{
  "expo": {
    "name": "DeutschSnap Study",
    "slug": "deutschsnap-study",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B67F8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deutschsnap.study"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B67F8"
      },
      "package": "com.deutschsnap.study"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DeutschSnap to use your camera to scan German worksheets."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DeutschSnap to access your photos to upload German worksheets."
        }
      ]
    ]
  }
}
